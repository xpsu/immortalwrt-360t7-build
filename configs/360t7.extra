# ============================================================
# 360T7 专用配置增量
# 基线：padavanonly/immortalwrt-mt798x-6.6 @ openwrt-24.10-6.6
#       defconfig/mt7981-ax3000.config（已含闭源 mt_wifi 驱动）
# ============================================================

# ---- 目标：只编 360T7 ----
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_qihoo_360t7=y
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_filogic_DEVICE_qihoo_360t7=""

# ---- 插件调整：不要 ksmbd，加 upnp ----
# CONFIG_PACKAGE_luci-app-ksmbd is not set
# CONFIG_PACKAGE_ksmbd-server is not set
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-package-manager=y

# ---- 编译加速 ----
CONFIG_CCACHE=y
